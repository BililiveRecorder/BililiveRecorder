<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="BililiveRecorder.Desktop.Pages.AnnouncementPage">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button HorizontalAlignment="Right" Margin="5,0" x:Name="RefreshButton" Click="Button_Click">
            <StackPanel Orientation="Horizontal">
                <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="刷新" Margin="5,0,0,0"/>
            </StackPanel>
        </Button>
        <Border Margin="5" Grid.Row="1" x:Name="Container" BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="1" CornerRadius="5">
            <ScrollViewer>
                <TextBlock x:Name="ContentTextBlock" TextWrapping="Wrap" Margin="10"/>
            </ScrollViewer>
        </Border>
        <StackPanel x:Name="Loading" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
            <ProgressBar IsIndeterminate="True" Width="80" Height="5" Margin="5"/>
            <TextBlock TextAlignment="Center" FontSize="18" Text="Loading……"/>
        </StackPanel>
        <TextBlock x:Name="Error" Grid.Row="1" FontSize="20" Text="加载失败"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"
                   Foreground="Red"/>
    </Grid>
</UserControl>
