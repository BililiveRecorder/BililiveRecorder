<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lucide="using:Lucide.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="BililiveRecorder.Desktop.Pages.ToolboxRemuxPage">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button VerticalAlignment="Bottom" DockPanel.Dock="Right" Click="Remux_Button_Click">
                <StackPanel Orientation="Horizontal">
                    <lucide:LucideIcon Kind="{x:Static lucide:LucideIconKind.Film}" Size="14" Margin="0,0,5,0"/>
                    <TextBlock Text="转封装"/>
                </StackPanel>
            </Button>
            <Button VerticalAlignment="Bottom" DockPanel.Dock="Right" Margin="0,0,5,0" Content="选择文件" Click="SelectFile_Button_Click"/>
            <TextBox x:Name="FileNameTextBox" Watermark="拖放FLV文件到此处或点击选择文件"/>
        </DockPanel>
        <Border Grid.Row="1" BorderThickness="1" CornerRadius="5"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="FLV 转封装为 MP4" FontSize="26" HorizontalAlignment="Center"/>
                <TextBlock Text="将 FLV 文件转封装为 MP4 格式，不进行重新编码" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="注意：需要系统中安装 FFmpeg" HorizontalAlignment="Center" Foreground="Orange" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
