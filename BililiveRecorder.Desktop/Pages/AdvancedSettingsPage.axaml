<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BililiveRecorder.Desktop.Pages"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="BililiveRecorder.Desktop.Pages.AdvancedSettingsPage">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="10" Margin="20">
            <TextBlock Text="高级设置 Advanced Settings" FontSize="28" FontWeight="SemiBold" Margin="0,10"/>
            
            <Border BorderBrush="Orange" BorderThickness="2" CornerRadius="5" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="⚠️ 警告 Warning" FontSize="18" FontWeight="SemiBold" Foreground="Orange"/>
                    <TextBlock TextWrapping="Wrap" Text="这些设置可能会导致问题，请谨慎使用。"/>
                    <TextBlock TextWrapping="Wrap" Text="These settings may cause issues. Use with caution."/>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="5" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="网络设置 Network Settings" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="用户脚本 User Script" Margin="0,5,0,0"/>
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="150" Text="{Binding UserScript}"/>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="5" Padding="15">
                <StackPanel Spacing="10">
                    <TextBlock Text="其他设置 Other Settings" FontSize="18" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="录制重试延迟(毫秒):" VerticalAlignment="Center"/>
                        <TextBox Width="100" Text="{Binding TimingStreamRetry}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="流连接超时(毫秒):" VerticalAlignment="Center"/>
                        <TextBox Width="100" Text="{Binding TimingStreamConnect}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="弹幕服务器重连时间(毫秒):" VerticalAlignment="Center"/>
                        <TextBox Width="100" Text="{Binding TimingDanmakuRetry}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
