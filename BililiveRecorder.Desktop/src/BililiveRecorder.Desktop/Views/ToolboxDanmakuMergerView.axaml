<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BililiveRecorder.Desktop.ViewModels"
             xmlns:m="using:BililiveRecorder.Desktop.Models"
             x:Class="BililiveRecorder.Desktop.Views.ToolboxDanmakuMergerView"
             x:DataType="vm:DanmakuMergerViewModel">

    <Grid Margin="16,12" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="{Binding Loc[Toolbox_Merge_Title_Long]}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Text="{Binding Loc[Toolbox_Merge_Tip]}" TextWrapping="Wrap" Opacity="0.8" />

        <ListBox Grid.Row="2" x:Name="FilesList" ItemsSource="{Binding Files}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:DanmakuFileWithOffset">
                    <Grid ColumnDefinitions="*,140,80" Margin="2" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding StartTime}" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="offset(s)" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding Offset}" Width="60" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button x:Name="AddButton" Content="{Binding Loc[Toolbox_Merge_Button_AddFile]}" Click="Add_Click" />
            <Button x:Name="RemoveButton" Content="{Binding Loc[Toolbox_Merge_Button_Remove]}" Click="Remove_Click" />
            <Button x:Name="MergeButton" Content="{Binding Loc[Toolbox_Merge_Button_Merge]}" Click="Merge_Click" Classes="accent" />
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8" />
    </Grid>
</UserControl>
