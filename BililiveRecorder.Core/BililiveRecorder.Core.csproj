<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Fluid.Core" Version="2.41.2" />
    <PackageReference Include="Flurl" Version="4.0.0" />
    <PackageReference Include="Jint" Version="4.18.1" />
    <PackageReference Include="JsonSubTypes" Version="2.2.0" />
    <PackageReference Include="HierarchicalPropertyDefault" Version="0.1.4-beta-g75fdf624b1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="4.0.1" />
    <PackageReference Include="Nerdbank.Streams" Version="2.14.416" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Polly" Version="7.2.3" />
    <PackageReference Include="Polly.Caching.Memory" Version="3.0.2" />
    <PackageReference Include="PolySharp" Version="1.17.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="StructLinq" Version="0.28.2" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.15" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\BililiveRecorder.Flv\BililiveRecorder.Flv.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="BrotliSharpLib" Version="0.3.3" />
  </ItemGroup>
  
</Project>
